<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_dark"
    tools:context=".MainActivity">

    <TextureView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="0dp"
        android:alpha="0" />

    <com.quicinc.semanticsegmentation.FragmentRender
        android:id="@+id/fragmentRender"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true" />

    <ProgressBar
        android:id="@+id/indeterminateBar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_centerInParent="true"
        android:visibility="invisible" />

    <!-- Control Panel at Bottom -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@color/stats_background">

        <!-- Colormap Selection Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/colormapButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnTurbo"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Turbo"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="@color/colorPrimary"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnMagma"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Magma"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#444444"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnViridis"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Viridis"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#444444"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnPlasma"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Plasma"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#444444"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnInferno"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Inferno"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#444444"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnGrayscale"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Gray"
                    android:textSize="12sp"
                    android:backgroundTint="#444444"
                    android:textColor="@color/text_primary" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnGallery"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Gallery"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/button_secondary"
                android:textColor="@color/background_dark" />

            <Button
                android:id="@+id/btnRuntime"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Runtime"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnProfile"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Profile"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Share"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@color/text_primary" />

        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
